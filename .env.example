# ==========================================
# E-wallet Go - Production Environment Setup
# ==========================================

# Port the server will listen on (default is 3000)
PORT=3000

# Environment mode: 'production' or 'development'
NODE_ENV=production

# (Optional) Google Gemini API Key for Socratic AI Math / Assistant features
GEMINI_API_KEY=

# (Optional) Custom Domain URL (e.g. https://www.ewalletgo.com)
APP_BASE_URL=https://www.ewalletgo.com
